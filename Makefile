# Agent98 - OpenWatcom wmake build for 32-bit Windows 9x/NT.
#
# Prerequisites:
#   * OpenWatcom 2.0 extracted to tools\openwatcom\ow (or set WATCOM_ROOT)
#   * WATCOM and INCLUDE environment variables set (build_ow.cmd does this)
#
# Usage:
#   build_ow.cmd            (recommended; sets up the environment)
#   wmake -f Makefile       (if the environment is already configured)
#
# ow\rules.mk and the link response files are generated by
# tools\gen_ow_build.ps1.  Re-run that script after adding or removing
# source files.

!ifndef WATCOM_ROOT
WATCOM_ROOT = tools\openwatcom\ow
!endif
CC   = $(WATCOM_ROOT)\binnt\wcl386.exe
LINK = $(WATCOM_ROOT)\binnt\wlink.exe
RC   = $(WATCOM_ROOT)\binnt\wrc.exe

all: build\ow\a98.exe build\ow\agent98.exe .SYMBOLIC

!include ow\rules.mk

build\ow\a98.exe: $(OBJS)
	$(LINK) @ow\link.rsp

build\ow\gui.res: src\gui\gui.rc src\gui\resource.h
	$(RC) -q -bt=nt -r -zm -fo=$@ src\gui\gui.rc

build\ow\agent98.exe: $(GUI_OBJS) build\ow\gui.res
	$(LINK) @ow\link_gui.rsp

gui: build\ow\agent98.exe .SYMBOLIC

probe: build\ow\tlsprobe.exe .SYMBOLIC

build\ow\tlsprobe.exe: $(PROBE_OBJS)
	$(LINK) @ow\link_tlsprobe.rsp

clean: .SYMBOLIC
	-@cmd /c if exist build\ow\obj rmdir /s /q build\ow\obj
	-@if exist build\ow\a98.exe del build\ow\a98.exe
	-@if exist build\ow\a98.map del build\ow\a98.map
	-@if exist build\ow\agent98.exe del build\ow\agent98.exe
	-@if exist build\ow\agent98.map del build\ow\agent98.map
	-@if exist build\ow\gui.res del build\ow\gui.res
	-@if exist build\ow\tlsprobe.exe del build\ow\tlsprobe.exe
	-@if exist build\ow\tlsprobe.map del build\ow\tlsprobe.map
	-@if exist build\ow\agent98.ini del build\ow\agent98.ini
