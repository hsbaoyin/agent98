/*
 * Agent98 - Win32 resources.
 *
 * Kept deliberately simple so that wrc (OpenWatcom) and windres (MinGW)
 * both accept the file.
 */
#include <windows.h>
#include "resource.h"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New conversation",        IDM_NEW
        MENUITEM "&Save session...",         IDM_SAVE
        MENUITEM "&Load session...",         IDM_LOAD
        MENUITEM "&Export transcript...",    IDM_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                    IDM_EXIT
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Open workspace",          IDM_WORKSPACE
        MENUITEM "&Settings...",             IDM_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&List tools...",          IDM_TOOLS_LIST
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Agent98",           IDM_ABOUT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    VK_ESCAPE, IDC_STOP, VIRTKEY
    "N", IDM_NEW, VIRTKEY, CONTROL
    "S", IDM_SAVE, VIRTKEY, CONTROL
    "O", IDM_LOAD, VIRTKEY, CONTROL
    "E", IDM_EXPORT, VIRTKEY, CONTROL
END

IDD_SETTINGS DIALOG 0, 0, 360, 260
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Agent98 Settings"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Provider:", -1, 8, 12, 58, 8
    COMBOBOX        IDC_PROVIDER, 72, 9, 130, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "A preset fills in the API base and model.", -1, 210, 12, 142, 8
    LTEXT           "API base:", -1, 8, 30, 58, 8
    EDITTEXT        IDC_API_BASE, 72, 27, 280, 12, ES_AUTOHSCROLL
    LTEXT           "API key:", -1, 8, 46, 58, 8
    EDITTEXT        IDC_API_KEY, 72, 43, 280, 12, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "Model:", -1, 8, 62, 58, 8
    EDITTEXT        IDC_MODEL, 72, 59, 280, 12, ES_AUTOHSCROLL
    LTEXT           "System prompt:", -1, 8, 78, 58, 8
    EDITTEXT        IDC_SYSTEM_PROMPT, 72, 75, 280, 40, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Temperature:", -1, 8, 121, 58, 8
    EDITTEXT        IDC_TEMPERATURE, 72, 118, 40, 12, ES_AUTOHSCROLL
    LTEXT           "Max tokens:", -1, 128, 121, 50, 8
    EDITTEXT        IDC_MAX_TOKENS, 180, 118, 42, 12, ES_AUTOHSCROLL
    LTEXT           "Max steps (0=inf):", -1, 232, 121, 54, 8
    EDITTEXT        IDC_MAX_STEPS, 288, 118, 42, 12, ES_AUTOHSCROLL
    LTEXT           "Extra headers:", -1, 8, 137, 58, 8
    EDITTEXT        IDC_EXTRA_HEADERS, 72, 134, 280, 26, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "Workspace:", -1, 8, 166, 58, 8
    EDITTEXT        IDC_WORKSPACE, 72, 163, 280, 12, ES_AUTOHSCROLL
    CONTROL         "Verify TLS certificates", IDC_TLS_VERIFY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 72, 182, 120, 10
    CONTROL         "Allow shell commands", IDC_ALLOW_SHELL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 200, 182, 120, 10
    CONTROL         "Stream responses", IDC_STREAM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 72, 195, 120, 10
    PUSHBUTTON      "Test connection", IDC_TEST, 72, 212, 80, 14
    LTEXT           "", IDC_TEST_RESULT, 158, 214, 194, 20
    DEFPUSHBUTTON   "OK", IDOK, 240, 238, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 296, 238, 50, 14
END

IDD_CONFIRM DIALOG 0, 0, 320, 210
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Agent98 - Confirm tool call"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "The model wants to use this tool:", -1, 8, 8, 300, 8
    LTEXT           "", IDC_CONFIRM_TOOL, 8, 22, 300, 8
    EDITTEXT        IDC_CONFIRM_ARGS, 8, 36, 304, 132, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "Allow", IDOK, 196, 182, 54, 14
    PUSHBUTTON      "Deny", IDCANCEL, 258, 182, 54, 14
END

IDD_ABOUT DIALOG 0, 0, 240, 120
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Agent98"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Agent98 0.1.0", -1, 12, 12, 216, 10
    LTEXT           "An AI agent for Windows 98 / 95 / ME.", -1, 12, 30, 216, 10
    LTEXT           "Native Win32, BearSSL TLS 1.2.", -1, 12, 46, 216, 10
    DEFPUSHBUTTON   "OK", IDOK, 182, 96, 50, 14
END
